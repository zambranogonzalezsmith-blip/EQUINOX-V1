# GEMINI_API_KEY: Requerida para consultar el Calendario Fiscal SENIAT con Google Search (/api/fiscal-calendar).
# En Vercel, configúrala en Settings > Environment Variables (sin prefijo VITE_).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública de despliegue (ej. https://equinox-books.vercel.app).
APP_URL="https://equinox-books.vercel.app"

# FIREBASE_PROJECT_ID / FIRESTORE_DATABASE_ID: Opcional en Vercel si ya se usa firebase-applet-config.json.
FIREBASE_PROJECT_ID="gen-lang-client-0084042355"
FIRESTORE_DATABASE_ID="(default)"
